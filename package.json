{
  "name": "paperclip-task-graph",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Obsidian-style graph of a company's projects, tasks and subtasks for Paperclip",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": ["paperclip", "plugin", "ui", "graph"],
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.831.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
